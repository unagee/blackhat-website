---
import { site } from '@/data/site'

const { labels } = site
const icon = 'M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM13 13l4 4'
---

<!-- A magnifier button the height of Contact. It opens into a search bar in the header,
     with results listed underneath. On narrow screens the bar spans the header row. -->
<div data-search class="lg:relative">
  <button
    type="button"
    data-search-open
    aria-expanded="false"
    aria-controls="site-search"
    aria-label={labels.searchLabel}
    class="grid size-12 place-items-center rounded-full border border-bone/25 text-bone transition-colors hover:border-bone"
  >
    <svg
      viewBox="0 0 20 20"
      class="size-4"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      aria-hidden="true"
    >
      <path d={icon}></path>
    </svg>
  </button>

  <form
    id="site-search"
    role="search"
    hidden
    data-search-form
    data-results={labels.searchResults}
    data-empty={labels.searchEmpty}
    class="absolute inset-x-4 top-2 z-10 sm:inset-x-6 lg:static lg:w-72"
  >
    <div class="flex h-12 items-center rounded-full border border-bone/40 bg-ink pr-1 pl-5 focus-within:border-bone">
      <label for="site-search-input" class="sr-only">
        {labels.searchLabel}
      </label>
      <input
        id="site-search-input"
        type="search"
        autocomplete="off"
        placeholder={labels.searchPlaceholder}
        data-search-input
        class="w-full min-w-0 bg-transparent text-sm text-bone uppercase placeholder:tracking-widest placeholder:text-ash focus:outline-none [&::-webkit-search-cancel-button]:appearance-none [&:not(:placeholder-shown)]:normal-case"
      />
      <button
        type="submit"
        aria-label={labels.search}
        class="grid size-10 shrink-0 place-items-center rounded-full text-bone hover:text-signal"
      >
        <svg
          viewBox="0 0 20 20"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <path d={icon}></path>
        </svg>
      </button>
    </div>

    <div
      hidden
      data-search-panel
      class="mt-2 w-full overflow-hidden rounded-2xl border border-hairline bg-ink-raised shadow-2xl lg:absolute lg:top-full lg:right-0 lg:w-[26rem]"
    >
      <p class="px-5 pt-4 text-sm text-ash" aria-live="polite" data-search-status></p>
      <ul class="max-h-[60vh] overflow-y-auto p-2" data-search-list></ul>
    </div>
    <p hidden data-search-hint>
      {labels.searchHint}
    </p>
  </form>
</div>

<script>
  type Entry = { title: string; kind: string; description: string; url: string; keywords: string }

  const root = document.querySelector<HTMLElement>('[data-search]')
  const toggle = root?.querySelector<HTMLButtonElement>('[data-search-open]')
  const form = root?.querySelector<HTMLFormElement>('[data-search-form]')
  const input = root?.querySelector<HTMLInputElement>('[data-search-input]')
  const panel = root?.querySelector<HTMLElement>('[data-search-panel]')
  const list = root?.querySelector<HTMLUListElement>('[data-search-list]')
  const status = root?.querySelector<HTMLElement>('[data-search-status]')
  const hint = root?.querySelector<HTMLElement>('[data-search-hint]')?.textContent ?? ''
  let index: Entry[] | null = null
  let results: Entry[] = []

  const load = async () => {
    if (index) return index
    const response = await fetch('/search.json')
    index = (await response.json()) as Entry[]
    return index
  }

  // Every word typed must appear somewhere in the entry; titles that match rank first,
  // then projects and services ahead of general pages.
  const search = (entries: Entry[], query: string) => {
    const terms = query.toLowerCase().split(/\s+/).filter(Boolean)
    return entries
      .map((entry) => {
        const title = entry.title.toLowerCase()
        const text = `${title} ${entry.kind} ${entry.description} ${entry.keywords}`.toLowerCase()
        if (!terms.every((term) => text.includes(term))) return null
        const score =
          terms.reduce((sum, term) => sum + (title.includes(term) ? 2 : 1), 0) +
          (entry.kind === 'Page' ? 0 : 0.5)
        return { entry, score }
      })
      .filter((item): item is { entry: Entry; score: number } => item !== null)
      .sort((a, b) => b.score - a.score)
      .slice(0, 8)
      .map((item) => item.entry)
  }

  const render = (query: string) => {
    if (!list || !status || !panel || !form) return
    panel.hidden = !query
    list.replaceChildren(
      ...results.map((entry) => {
        const item = document.createElement('li')
        const link = document.createElement('a')
        link.href = entry.url
        link.className = 'block rounded-xl px-4 py-3 hover:bg-ink focus:bg-ink focus:outline-none'
        const top = document.createElement('span')
        top.className = 'flex items-baseline justify-between gap-4'
        const title = document.createElement('span')
        title.className = 'text-bone'
        title.textContent = entry.title
        const kind = document.createElement('span')
        kind.className = 'text-xs uppercase tracking-widest text-ash'
        kind.textContent = entry.kind
        const description = document.createElement('span')
        description.className = 'mt-1 block text-sm text-ash'
        description.textContent = entry.description
        top.append(title, kind)
        link.append(top, description)
        item.append(link)
        return item
      }),
    )
    if (results.length === 0)
      status.textContent = `${(form.dataset.empty ?? '').replace('{query}', query)}. ${hint}`
    else
      status.textContent = (form.dataset.results ?? '').replace('{count}', String(results.length))
  }

  const setOpen = (open: boolean) => {
    if (!toggle || !form || !input) return
    toggle.setAttribute('aria-expanded', String(open))
    toggle.hidden = open
    form.hidden = !open
    if (open) {
      input.focus()
      void load()
    } else {
      input.value = ''
      results = []
      render('')
    }
  }

  toggle?.addEventListener('click', () => setOpen(true))

  input?.addEventListener('input', async () => {
    const query = input.value.trim()
    results = query ? search(await load(), query) : []
    render(query)
  })

  // Enter goes straight to the best match.
  form?.addEventListener('submit', (event) => {
    event.preventDefault()
    if (results[0]) window.location.href = results[0].url
    else input?.focus()
  })

  // Escape closes the bar and returns focus to the magnifier.
  root?.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || form?.hidden) return
    event.preventDefault()
    setOpen(false)
    toggle?.focus()
  })

  // Close when the visitor clicks or tabs away from the search.
  document.addEventListener('pointerdown', (event) => {
    if (root && !form?.hidden && !root.contains(event.target as Node)) setOpen(false)
  })
  root?.addEventListener('focusout', (event) => {
    const next = event.relatedTarget as Node | null
    if (next && !root.contains(next)) setOpen(false)
  })
</script>
