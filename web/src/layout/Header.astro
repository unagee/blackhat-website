---
import wordmark from '@/assets/logos/blackhat-wordmark.png'
import ArrowIcon from '@/components/ui/ArrowIcon.astro'
import Button from '@/components/ui/Button.astro'
import Container from '@/components/ui/Container.astro'
import { site } from '@/data/site'
import type { NavItem, NavMenu } from '@/types'
import { Image } from 'astro:assets'

const isMenu = (item: NavItem): item is NavMenu => 'columns' in item
const path = Astro.url.pathname
const current = (href: string) => (href === path ? 'page' : undefined)
---

<header data-site-header class="sticky top-0 z-50 border-b border-hairline bg-ink/90 backdrop-blur">
  <Container class="flex h-16 items-center justify-between gap-6">
    <a href="/" aria-label={site.labels.home} class="shrink-0">
      <Image src={wordmark} alt="" width={160} class="h-5 w-auto invert sm:h-6" loading="eager" />
    </a>

    <nav aria-label={site.labels.mainNavigation} class="hidden flex-1 md:block">
      <ul class="flex items-center gap-8 text-sm">
        {site.nav.map((item, index) =>
          isMenu(item) ? (
            <li>
              <button
                type="button"
                data-disclosure
                aria-expanded="false"
                aria-controls={`nav-menu-${index}`}
                class="group inline-flex items-center gap-1.5 py-2 text-bone/85 hover:text-bone aria-expanded:text-bone"
              >
                {item.label}
                <svg
                  viewBox="0 0 16 16"
                  class="size-3 transition-transform group-aria-expanded:rotate-180 motion-reduce:transition-none"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  aria-hidden="true"
                >
                  <path d="M4 6l4 4 4-4" />
                </svg>
              </button>
              <div
                id={`nav-menu-${index}`}
                hidden
                class="absolute inset-x-0 top-full border-b border-hairline bg-ink-raised"
              >
                <Container class="grid gap-10 py-10 sm:grid-cols-3">
                  {item.columns.map((column) => (
                    <div class="sm:border-r sm:border-hairline sm:pr-10 sm:last:border-r-0">
                      <p class="eyebrow text-ash">{column.title}</p>
                      <ul class="mt-6 space-y-4">
                        {column.links.map((link) => (
                          <li>
                            <a
                              href={link.href}
                              aria-current={current(link.href)}
                              class="text-lg text-bone hover:text-signal"
                            >
                              {link.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                  <div class="flex items-end">
                    <a
                      href={item.footerLink.href}
                      class="inline-flex items-center gap-2 text-sm text-bone hover:text-signal"
                    >
                      {item.footerLink.label}
                      <ArrowIcon />
                    </a>
                  </div>
                </Container>
              </div>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={current(item.href)}
                class="py-2 text-bone/85 hover:text-bone aria-[current=page]:text-signal"
              >
                {item.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <Button href={site.cta.href} class="py-2">
        {site.cta.label}
      </Button>
      <button
        type="button"
        data-disclosure
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex items-center rounded-full border border-bone/40 px-4 py-2 text-sm hover:border-bone md:hidden"
      >
        {site.labels.menu}
      </button>
    </div>
  </Container>

  <nav
    id="mobile-menu"
    hidden
    aria-label={site.labels.mainNavigation}
    class="max-h-[calc(100svh-4rem)] overflow-y-auto border-t border-hairline bg-ink md:hidden"
  >
    <Container class="space-y-10 py-8">
      {site.nav.map((item) =>
        isMenu(item) ? (
          item.columns.map((column) => (
            <div>
              <p class="eyebrow text-ash">{column.title}</p>
              <ul class="mt-4 space-y-3">
                {column.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-lg hover:text-signal">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        ) : (
          <a href={item.href} class="block text-2xl hover:text-signal">
            {item.label}
          </a>
        ),
      )}
      <Button href={site.cta.href} arrow>
        {site.cta.label}
      </Button>
    </Container>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]')
  const toggles = [...document.querySelectorAll<HTMLButtonElement>('[data-disclosure]')]
  const panelOf = (button: HTMLButtonElement) =>
    document.getElementById(button.getAttribute('aria-controls') ?? '')

  const setOpen = (button: HTMLButtonElement, open: boolean) => {
    button.setAttribute('aria-expanded', String(open))
    const panel = panelOf(button)
    if (panel) panel.hidden = !open
  }
  const closeAll = (except?: HTMLButtonElement) =>
    toggles.filter((button) => button !== except).forEach((button) => setOpen(button, false))

  toggles.forEach((button) => {
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true'
      closeAll(button)
      setOpen(button, open)
    })
  })

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return
    const open = toggles.find((button) => button.getAttribute('aria-expanded') === 'true')
    if (!open) return
    setOpen(open, false)
    open.focus()
  })

  // Close when the visitor clicks or tabs anywhere outside the header.
  document.addEventListener('click', (event) => {
    if (header && !header.contains(event.target as Node)) closeAll()
  })
  header?.addEventListener('focusout', (event) => {
    const next = event.relatedTarget as Node | null
    if (next && !header.contains(next)) closeAll()
  })
</script>
