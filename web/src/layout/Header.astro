---
import ArrowIcon from '@/components/ui/ArrowIcon.astro'
import Button from '@/components/ui/Button.astro'
import Container from '@/components/ui/Container.astro'
import Wordmark from '@/components/ui/Wordmark.astro'
import { site } from '@/data/site'
import type { NavItem, NavMenu, NavPanes } from '@/types'
import SiteSearch from './SiteSearch.astro'

const isMenu = (item: NavItem): item is NavMenu => 'columns' in item
const isPanes = (item: NavItem): item is NavPanes => 'groups' in item
const hasPanel = (item: NavItem): item is NavMenu | NavPanes => isMenu(item) || isPanes(item)
const path = Astro.url.pathname
const current = (href: string) => (href === path ? 'page' : undefined)
---

<!-- White header with black text. Its frosted ground is a separate layer, so the dropdown
     panels (siblings of that layer) can blur the page behind them too: a blur nested inside
     another blur only sees its parent. -->
<header
  data-site-header
  class="theme-white sticky top-0 z-50 border-b border-hairline bg-transparent"
>
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-ink"></div>
  <!-- The displacement filter behind the menus' liquid glass refraction (see styles.css). -->
  <svg aria-hidden="true" class="absolute size-0">
    <filter
      id="liquid-refraction"
      x="0"
      y="0"
      width="100%"
      height="100%"
      color-interpolation-filters="sRGB"
    >
      <feTurbulence type="fractalNoise" baseFrequency="0.0035 0.011" numOctaves="2" seed="7" />
      <feGaussianBlur stdDeviation="3" result="waves" />
      <feDisplacementMap
        in="SourceGraphic"
        in2="waves"
        scale="34"
        xChannelSelector="R"
        yChannelSelector="G"
      />
    </filter>
  </svg>
  <Container class="flex h-16 items-center justify-between gap-6">
    <a href="/" aria-label={site.labels.home} class="shrink-0">
      <Wordmark class="h-6 sm:h-7" variant="dark" eager />
    </a>

    <nav aria-label={site.labels.mainNavigation} class="hidden flex-1 md:block">
      <ul class="flex items-center gap-8 text-sm">
        {site.nav.map((item, index) =>
          hasPanel(item) ? (
            <li>
              <button
                type="button"
                data-disclosure
                aria-expanded="false"
                aria-controls={`nav-menu-${index}`}
                class="group inline-flex items-center gap-1.5 py-2 text-bone/85 hover:text-bone aria-expanded:text-bone"
              >
                {item.label}
                <svg
                  viewBox="0 0 16 16"
                  class="size-3 transition-transform group-aria-expanded:rotate-180 motion-reduce:transition-none"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  aria-hidden="true"
                >
                  <path d="M4 6l4 4 4-4" />
                </svg>
              </button>
              <!-- Two-pane menus show their list on the left and the hovered or focused item's panel on
                   the right; without JavaScript the first panel stays visible. -->
              <div id={`nav-menu-${index}`} hidden class="liquid-glass absolute inset-x-0 top-full">
                <!-- Liquid glass, in layers behind the content: a lightly blurred body, a refraction
                     layer that warps the page, a thicker rim along the edges, and the glare on top. -->
                <div
                  aria-hidden="true"
                  class="liquid-glass-body pointer-events-none absolute inset-0 -z-10 backdrop-blur-[7px] backdrop-brightness-[1.04] backdrop-saturate-[1.9]"
                ></div>
                <div
                  aria-hidden="true"
                  class="liquid-glass-refraction pointer-events-none absolute inset-0 -z-10"
                ></div>
                <div
                  aria-hidden="true"
                  class="liquid-glass-rim pointer-events-none absolute inset-0 -z-10 backdrop-blur-[18px] backdrop-brightness-[1.22] backdrop-saturate-[2.2]"
                ></div>
                <div
                  aria-hidden="true"
                  class="liquid-glass-shine pointer-events-none absolute inset-0 -z-10"
                ></div>
                {isPanes(item) ? (
                  <Container>
                    <div
                      data-panes
                      class="grid gap-10 py-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]"
                    >
                      <div class="lg:border-r lg:border-hairline lg:pr-10">
                        <p class="eyebrow text-ash">{item.hint}</p>
                        <ul class="mt-6 space-y-1">
                          {item.groups.map((group, groupIndex) => (
                            <li>
                              <a
                                href={group.href}
                                data-pane-link={groupIndex}
                                aria-current={current(group.href)}
                                class="group/pane flex items-center justify-between gap-4 rounded-md px-3 py-2 text-lg text-bone/70 hover:text-bone data-active:bg-bone/5 data-active:text-bone"
                                data-active={groupIndex === 0 ? '' : undefined}
                              >
                                {group.label}
                                <ArrowIcon class="size-3.5 opacity-0 transition-opacity group-data-active/pane:opacity-100 motion-reduce:transition-none" />
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                      <div>
                        {item.groups.map((group, groupIndex) => (
                          <div data-pane={groupIndex} hidden={groupIndex !== 0}>
                            <p class="text-xl text-bone">{group.lead}</p>
                            <ul class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-2">
                              {group.items.map((entry) => (
                                <li>
                                  <p class="font-medium text-bone">{entry.title}</p>
                                  <p class="mt-1 text-sm text-ash">{entry.body}</p>
                                </li>
                              ))}
                            </ul>
                            <a
                              href={group.href}
                              tabindex="-1"
                              class="mt-8 inline-flex items-center gap-2 text-sm text-bone hover:text-signal"
                            >
                              {group.label}
                              <ArrowIcon />
                            </a>
                          </div>
                        ))}
                        <a
                          href={item.footerLink.href}
                          class="mt-4 inline-flex items-center gap-2 text-sm text-ash hover:text-signal lg:float-right"
                        >
                          {item.footerLink.label}
                          <ArrowIcon />
                        </a>
                      </div>
                    </div>
                  </Container>
                ) : (
                  <Container class="grid gap-10 py-10 sm:grid-cols-3">
                    {item.columns.map((column) => (
                      <div class="sm:border-r sm:border-hairline sm:pr-10 sm:last:border-r-0">
                        <p class="eyebrow text-ash">{column.title}</p>
                        <ul class="mt-6 space-y-4">
                          {column.links.map((link) => (
                            <li>
                              <a
                                href={link.href}
                                aria-current={current(link.href)}
                                class="text-lg text-bone hover:text-signal"
                              >
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                    <div class="flex items-end">
                      <a
                        href={item.footerLink.href}
                        class="inline-flex items-center gap-2 text-sm text-bone hover:text-signal"
                      >
                        {item.footerLink.label}
                        <ArrowIcon />
                      </a>
                    </div>
                  </Container>
                )}
              </div>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={current(item.href)}
                class="py-2 text-bone/85 decoration-signal decoration-2 underline-offset-8 hover:text-bone aria-[current=page]:text-bone aria-[current=page]:underline"
              >
                {item.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <SiteSearch />
      <Button href={site.cta.href} class="py-2 max-sm:hidden">
        {site.cta.label}
      </Button>
      <button
        type="button"
        data-disclosure
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex h-12 items-center rounded-full border border-bone/40 px-5 text-sm hover:border-bone md:hidden"
      >
        {site.labels.menu}
      </button>
    </div>
  </Container>

  <nav
    id="mobile-menu"
    hidden
    aria-label={site.labels.mainNavigation}
    class="max-h-[calc(100svh-4rem)] overflow-y-auto border-t border-hairline bg-ink/90 backdrop-blur-2xl backdrop-saturate-150 md:hidden"
  >
    <Container class="space-y-10 py-8">
      {site.nav.map((item) =>
        isPanes(item) ? (
          <div>
            <p class="eyebrow text-ash">{item.label}</p>
            <ul class="mt-4 space-y-3">
              {item.groups.map((group) => (
                <li>
                  <a href={group.href} class="text-lg hover:text-signal">
                    {group.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : isMenu(item) ? (
          item.columns.map((column) => (
            <div>
              <p class="eyebrow text-ash">{column.title}</p>
              <ul class="mt-4 space-y-3">
                {column.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-lg hover:text-signal">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        ) : (
          <a href={item.href} class="block text-2xl hover:text-signal">
            {item.label}
          </a>
        ),
      )}
      <Button href={site.cta.href} arrow>
        {site.cta.label}
      </Button>
    </Container>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]')
  const toggles = [...document.querySelectorAll<HTMLButtonElement>('[data-disclosure]')]
  const panelOf = (button: HTMLButtonElement) =>
    document.getElementById(button.getAttribute('aria-controls') ?? '')

  const setOpen = (button: HTMLButtonElement, open: boolean) => {
    button.setAttribute('aria-expanded', String(open))
    const panel = panelOf(button)
    if (panel) panel.hidden = !open
  }
  const closeAll = (except?: HTMLButtonElement) =>
    toggles.filter((button) => button !== except).forEach((button) => setOpen(button, false))

  toggles.forEach((button) => {
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true'
      closeAll(button)
      setOpen(button, open)
    })
  })

  // Two-pane menus: hovering or focusing an item on the left shows its panel on the right.
  document.querySelectorAll<HTMLElement>('[data-panes]').forEach((panes) => {
    const links = [...panes.querySelectorAll<HTMLElement>('[data-pane-link]')]
    const panels = [...panes.querySelectorAll<HTMLElement>('[data-pane]')]
    const show = (index: string | undefined) => {
      links.forEach((link) => link.toggleAttribute('data-active', link.dataset.paneLink === index))
      panels.forEach((panel) => (panel.hidden = panel.dataset.pane !== index))
    }
    links.forEach((link) => {
      link.addEventListener('pointerenter', () => show(link.dataset.paneLink))
      link.addEventListener('focus', () => show(link.dataset.paneLink))
    })
  })

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return
    const open = toggles.find((button) => button.getAttribute('aria-expanded') === 'true')
    if (!open) return
    setOpen(open, false)
    open.focus()
  })

  // Close when the visitor clicks or tabs anywhere outside the header.
  document.addEventListener('click', (event) => {
    if (header && !header.contains(event.target as Node)) closeAll()
  })
  header?.addEventListener('focusout', (event) => {
    const next = event.relatedTarget as Node | null
    if (next && !header.contains(next)) closeAll()
  })
</script>
