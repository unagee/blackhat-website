---
import ServiceWork from '@/components/services/ServiceWork.astro'
import ArrowIcon from '@/components/ui/ArrowIcon.astro'
import Container from '@/components/ui/Container.astro'
import ContactClose from '@/components/ui/ContactClose.astro'
import Faq from '@/components/ui/Faq.astro'
import LoopVideo from '@/components/ui/LoopVideo.astro'
import PageSection from '@/components/ui/PageSection.astro'
import SectionHeader from '@/components/ui/SectionHeader.astro'
import { industries, industriesPage, industryHref, type Industry } from '@/data/industries'
import { projectBySlug, projectHref } from '@/data/projects'
import { serviceHref, services } from '@/data/services'
import Layout from '@/layout/Layout.astro'
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/schema'
import { Image } from 'astro:assets'

export function getStaticPaths() {
  return industries.map((industry) => ({ params: { slug: industry.slug }, props: { industry } }))
}

type Props = {
  industry: Industry
}

// One template for every industry, part statement page and part showcase: a big line, one
// piece of work in motion (or a still), the problem we solve, what we do, the work, questions,
// and links to the other industries.
const { industry } = Astro.props
const href = industryHref(industry.slug)
const meta = { ...industry.meta, noIndex: !industriesPage.ready }
const parent = industriesPage.allLink
const schema = [
  breadcrumbSchema([
    { label: 'Home', href: '/' },
    { label: industriesPage.eyebrow, href: parent.href },
    { label: industry.name, href },
  ]),
  serviceSchema(industry.name, industry.meta.description ?? industry.intro, href),
  faqSchema(industry.faq),
]
const serviceName = (slug: string) => services.find((service) => service.slug === slug)?.name
const media = industry.media
const mediaProject = projectBySlug(media.slug)
const others = industries.filter((other) => other.slug !== industry.slug)
---

<Layout meta={meta} schema={schema}>
  <!-- Hero on white: the industry on the left, the line on the right. -->
  <section class="theme-white bg-ink pt-24 pb-16 sm:pt-32 sm:pb-24">
    <Container>
      <nav aria-label={industriesPage.breadcrumbLabel} class="mb-10">
        <a href={parent.href} class="eyebrow text-ash hover:text-bone">
          {industriesPage.eyebrow} /
        </a>
      </nav>
      <div class="grid gap-6 lg:grid-cols-[1fr_2.2fr] lg:gap-12">
        <p aria-hidden="true" class="eyebrow pt-3 text-ash">
          {industry.name}
        </p>
        <div>
          <h1 class="text-display-xl">
            <span class="sr-only">{industry.name}: </span>
            {industry.lead}
          </h1>
          <p class="text-lead mt-8 max-w-2xl text-ash">{industry.intro}</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- One piece of work, big, on black. -->
  <PageSection labelledby="media-caption">
    {media.type === 'video' && media.shape === 'square' ? (
      <div class="grid items-center gap-10 md:grid-cols-2 md:gap-16">
        <LoopVideo src={media.src} poster={media.poster} class="aspect-square w-full rounded-lg" />
        <div>
          <p id="media-caption" class="text-display-md">
            {media.caption}
          </p>
          <a
            href={projectHref(media.slug)}
            class="mt-8 inline-flex items-center gap-2 text-bone hover:text-signal"
          >
            {industriesPage.seeProject}
            <ArrowIcon />
          </a>
        </div>
      </div>
    ) : (
      <figure>
        {media.type === 'film' && mediaProject.video ? (
          <div class="relative aspect-video w-full overflow-hidden rounded-lg bg-ink-raised">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${mediaProject.video.youtubeId}?autoplay=1&mute=1&loop=1&playlist=${mediaProject.video.youtubeId}&playsinline=1&rel=0&modestbranding=1`}
              title={mediaProject.video.title}
              allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
              class="absolute inset-0 size-full"
            ></iframe>
          </div>
        ) : media.type === 'video' ? (
          <LoopVideo src={media.src} poster={media.poster} class="aspect-video w-full rounded-lg" />
        ) : (
          <Image
            src={mediaProject.image.src}
            alt={mediaProject.image.alt}
            widths={[640, 960, 1280, 1920]}
            sizes="(min-width: 1152px) 1152px, 100vw"
            class="aspect-video w-full rounded-lg object-cover"
          />
        )}
        <figcaption class="mt-6 flex flex-wrap items-baseline justify-between gap-4">
          <span id="media-caption" class="text-lg">
            {media.caption}
          </span>
          <a
            href={projectHref(media.slug)}
            class="inline-flex items-center gap-2 text-sm text-ash hover:text-signal"
          >
            {industriesPage.seeProject}
            <ArrowIcon />
          </a>
        </figcaption>
      </figure>
    )}
  </PageSection>

  <!-- The problem we solve here. -->
  <PageSection tone="white" labelledby="challenge-title">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="eyebrow text-ash">{industriesPage.challengeEyebrow}</p>
        <h2 id="challenge-title" class="text-display-md mt-4">
          {industry.challenge.title}
        </h2>
      </div>
      <div class="space-y-5 text-lg text-ash">
        {industry.challenge.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </PageSection>

  <!-- What we do here, as a list: title, one line, the service it belongs to. -->
  <PageSection id="offerings" tone="grey" labelledby="offerings-title">
    <SectionHeader
      id="offerings-title"
      eyebrow={industriesPage.offeringsEyebrow}
      title={industriesPage.offeringsTitle}
    />
    <ul class="border-t border-hairline">
      {industry.offerings.map((offering) => (
        <li class="grid gap-3 border-b border-hairline py-7 md:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)_minmax(0,14rem)] md:items-baseline md:gap-10">
          <h3 class="text-xl">{offering.title}</h3>
          <p class="text-ash">{offering.body}</p>
          <a
            href={serviceHref(offering.service)}
            class="text-sm text-bone/80 underline-offset-4 hover:underline"
          >
            {serviceName(offering.service)}
          </a>
        </li>
      ))}
    </ul>
  </PageSection>

  <ServiceWork
    eyebrow={industriesPage.workEyebrow}
    title={industriesPage.workTitle}
    projects={industry.projects.map(projectBySlug)}
    allLink={industriesPage.allWork}
    tone="white"
  />

  <Faq
    eyebrow={industriesPage.faqEyebrow}
    title={industriesPage.faqTitle}
    items={industry.faq}
    tone="grey"
  />

  <!-- The other industries, for the next click. -->
  <PageSection labelledby="other-title">
    <h2 id="other-title" class="text-display-md mb-10">
      {industriesPage.otherTitle}
    </h2>
    <ul class="border-t border-hairline">
      {others.map((other) => (
        <li class="group relative border-b border-hairline">
          <div class="grid gap-2 py-6 md:grid-cols-[1fr_1fr_auto] md:items-center md:gap-10">
            <h3 class="text-2xl">
              <a
                href={industryHref(other.slug)}
                class="after:absolute after:inset-0 group-hover:text-signal"
              >
                {other.name}
              </a>
            </h3>
            <p class="text-ash">{other.lead}</p>
            <span
              aria-hidden="true"
              class="hidden size-10 place-items-center rounded-full border border-bone/40 transition-colors group-hover:border-signal group-hover:bg-signal group-hover:text-on-signal md:grid"
            >
              <ArrowIcon />
            </span>
          </div>
        </li>
      ))}
    </ul>
  </PageSection>

  <ContactClose />
</Layout>
