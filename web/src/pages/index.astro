---
import Clients from '@/components/home/Clients.astro'
import FeaturedProject from '@/components/home/FeaturedProject.astro'
import Hero from '@/components/home/Hero.astro'
import Industries from '@/components/home/Industries.astro'
import SelectedWork from '@/components/home/SelectedWork.astro'
import Services from '@/components/home/Services.astro'
import Showcase from '@/components/home/Showcase.astro'
import ContactClose from '@/components/ui/ContactClose.astro'
import CtaBanner from '@/components/ui/CtaBanner.astro'
import { home } from '@/data/home'
import Layout from '@/layout/Layout.astro'
---

<Layout meta={home.meta}>
  <Hero />
  <Services />
  <Clients />
  <CtaBanner {...home.prompt} graphic="right" pattern="cells" />
  <FeaturedProject />
  <SelectedWork />
  <Industries />
  <Showcase />
  <ContactClose />
</Layout>
