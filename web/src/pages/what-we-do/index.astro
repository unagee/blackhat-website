---
import Industries from '@/components/home/Industries.astro'
import Engagement from '@/components/services/Engagement.astro'
import EnquiryForm from '@/components/services/EnquiryForm.astro'
import ServiceList from '@/components/services/ServiceList.astro'
import PageHero from '@/components/ui/PageHero.astro'
import { whatWeDo } from '@/data/services'
import Layout from '@/layout/Layout.astro'
import { breadcrumbSchema } from '@/lib/schema'

const schema = [
  breadcrumbSchema([
    { label: 'Home', href: '/' },
    { label: whatWeDo.eyebrow, href: '/what-we-do' },
  ]),
]
---

<Layout meta={whatWeDo.meta} schema={schema}>
  <PageHero eyebrow={whatWeDo.eyebrow} title={whatWeDo.title} lead={whatWeDo.lead} />
  <Engagement />
  <ServiceList title={whatWeDo.listTitle} services={whatWeDo.list} />
  <Industries />
  <EnquiryForm />
</Layout>
