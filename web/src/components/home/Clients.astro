---
import Container from '@/components/ui/Container.astro'
import { home } from '@/data/home'
import { Image } from 'astro:assets'

const { clients } = home
---

<section
  aria-labelledby="clients-title"
  class="theme-grey border-t border-hairline bg-ink py-16 sm:py-20"
>
  <Container>
    <h2 id="clients-title" class="eyebrow text-ash">
      {clients.title}
    </h2>
  </Container>

  <!-- The row pauses while hovered and stays still for visitors who prefer reduced motion. -->
  <div class="group mt-10 overflow-hidden motion-reduce:overflow-visible">
    <div class="flex w-max animate-marquee group-hover:[animation-play-state:paused] motion-reduce:w-auto motion-reduce:animate-none">
      {[false, true].map((duplicate) => (
        <ul
          class:list={[
            'flex shrink-0 items-center gap-16 pr-16 sm:gap-24 sm:pr-24',
            'motion-reduce:w-full motion-reduce:flex-wrap motion-reduce:justify-center motion-reduce:px-4',
            duplicate && 'motion-reduce:hidden',
          ]}
          aria-hidden={duplicate ? 'true' : undefined}
        >
          {clients.logos.map((logo) => (
            <li>
              <Image
                src={logo.src}
                alt={duplicate ? '' : logo.alt}
                width={160}
                height={160}
                class="h-20 w-20 object-contain opacity-80 sm:h-28 sm:w-28"
              />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>
