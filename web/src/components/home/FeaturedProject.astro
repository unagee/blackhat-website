---
import ArrowIcon from '@/components/ui/ArrowIcon.astro'
import Button from '@/components/ui/Button.astro'
import Container from '@/components/ui/Container.astro'
import { home } from '@/data/home'
import { Image } from 'astro:assets'

const { featured } = home
const total = featured.items.length
const position = (index: number) =>
  featured.position.replace('{current}', String(index + 1)).replace('{total}', String(total))
---

<!-- Featured projects, one at a time. Slides share one grid cell so the card keeps the height of
     the tallest; hidden slides are invisible, so they leave the tab order and the reading order. -->
<section
  aria-label={featured.label}
  aria-roledescription="carousel"
  data-featured
  data-position={featured.position}
  class="border-t border-hairline bg-ink py-20 sm:py-28"
>
  <Container>
    <div class="relative overflow-hidden rounded-lg bg-ink-raised">
      <div class="grid">
        {featured.items.map((item, index) => (
          <article
            data-featured-slide
            aria-roledescription="slide"
            aria-label={position(index)}
            class:list={[
              'relative isolate col-start-1 row-start-1 transition-opacity duration-500 motion-reduce:transition-none',
              index > 0 && 'invisible opacity-0',
            ]}
          >
            <Image
              src={item.image.src}
              alt={item.image.alt}
              widths={[640, 960, 1280, 1920]}
              sizes="(min-width: 1152px) 1152px, 100vw"
              class="aspect-video w-full object-cover lg:absolute lg:inset-0 lg:-z-10 lg:aspect-auto lg:h-full"
            />
            <div
              aria-hidden="true"
              class="absolute inset-0 -z-10 hidden bg-linear-to-r from-ink/95 via-ink/70 to-transparent lg:block"
            ></div>
            <div class="p-6 sm:p-10 lg:flex lg:min-h-[38rem] lg:max-w-xl lg:flex-col lg:justify-end lg:p-14">
              <p class="eyebrow text-signal">{featured.eyebrow}</p>
              <p class="mt-6 text-ash">{item.client}</p>
              <h2 id={`featured-title-${index}`} class="text-display-md mt-2">
                {item.title}
              </h2>
              <p class="mt-5 text-bone/80">{item.body}</p>
              <ul class="mt-6 flex flex-wrap gap-2">
                {item.tags.map((tag) => (
                  <li class="rounded-full border border-bone/30 px-3 py-1 text-sm text-bone/80">
                    {tag}
                  </li>
                ))}
              </ul>
              <div class="mt-8">
                <Button href={item.link.href} variant="secondary" arrow>
                  {item.link.label}
                </Button>
              </div>
            </div>
          </article>
        ))}
      </div>

      {total > 1 && (
        <div class="flex items-center justify-end gap-3 px-6 pb-6 sm:px-10 sm:pb-10 lg:absolute lg:right-10 lg:bottom-10 lg:p-0">
          <p data-featured-status aria-live="polite" class="mr-2 text-sm text-ash">
            {position(0)}
          </p>
          <button
            type="button"
            data-featured-step="-1"
            aria-label={featured.previous}
            class="grid size-12 place-items-center rounded-full border border-bone/40 bg-ink/60 text-bone backdrop-blur transition-colors hover:border-bone"
          >
            <ArrowIcon class="size-4 rotate-180" />
          </button>
          <button
            type="button"
            data-featured-step="1"
            aria-label={featured.next}
            class="grid size-12 place-items-center rounded-full bg-bone text-ink transition-colors hover:bg-signal"
          >
            <ArrowIcon class="size-4" />
          </button>
        </div>
      )}
    </div>
  </Container>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-featured]')
  const slides = [...(root?.querySelectorAll<HTMLElement>('[data-featured-slide]') ?? [])]
  const status = root?.querySelector<HTMLElement>('[data-featured-status]')
  let current = 0

  const show = (index: number) => {
    current = (index + slides.length) % slides.length
    slides.forEach((slide, i) => {
      slide.classList.toggle('invisible', i !== current)
      slide.classList.toggle('opacity-0', i !== current)
    })
    if (status && root?.dataset.position)
      status.textContent = root.dataset.position
        .replace('{current}', String(current + 1))
        .replace('{total}', String(slides.length))
  }

  root?.querySelectorAll<HTMLButtonElement>('[data-featured-step]').forEach((button) => {
    button.addEventListener('click', () => show(current + Number(button.dataset.featuredStep)))
  })
</script>
