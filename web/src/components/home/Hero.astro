---
import Button from '@/components/ui/Button.astro'
import Container from '@/components/ui/Container.astro'
import Highlighted from '@/components/ui/Highlighted.astro'
import Grain from '@/components/ui/Grain.astro'
import { home } from '@/data/home'
import { site } from '@/data/site'
import { getImage, Image } from 'astro:assets'

const { hero } = home
const { media } = hero
const still = media.type === 'image' ? media.image : media.poster
const poster =
  media.type === 'video' ? await getImage({ src: media.poster.src, width: 1920 }) : null
---

<section class="relative isolate flex min-h-[calc(100svh-4rem)] items-end overflow-hidden pt-32 pb-12 sm:pb-16">
  <div class="absolute inset-0 -z-10">
    <!-- The reel sits in the top part of the hero and fades out, so the words typed in the reel
         stay above the headline instead of behind it. Shorter screens give it less room. -->
    <div
      class:list={[
        'absolute inset-0',
        media.type === 'video' &&
          'bottom-[38%] [mask-image:linear-gradient(to_bottom,black_70%,transparent)] md:bottom-[14%] [@media(min-width:768px)_and_(max-height:820px)]:bottom-[24%]!',
      ]}
    >
      <Image
        src={still.src}
        alt={still.alt}
        widths={[640, 960, 1280, 1920, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class:list={[
          'size-full object-cover',
          media.type === 'video' &&
            'md:object-[center_40%] [@media(min-width:768px)_and_(max-height:820px)]:object-[center_75%]!',
        ]}
      />
      {media.type === 'video' && poster && (
        <video
          data-hero-video
          class="absolute inset-0 size-full object-cover motion-reduce:hidden md:object-[center_40%] [@media(min-width:768px)_and_(max-height:820px)]:object-[center_75%]!"
          poster={poster.src}
          autoplay
          muted
          loop
          playsinline
          aria-hidden="true"
        >
          {media.sources.map((source) => (
            <source src={source.src} type={source.type} media={source.media} />
          ))}
        </video>
      )}
    </div>
    <!-- Overlays keep the headline at WCAG AA contrast on any frame; the reel gets a light wash
         so it shows through, and the dark gradient sits under the text. -->
    <div
      aria-hidden="true"
      class:list={['absolute inset-0', media.type === 'video' ? 'bg-ink/25' : 'bg-ink/40']}
    ></div>
    <div
      aria-hidden="true"
      class:list={[
        'absolute inset-0 bg-linear-to-t from-ink',
        media.type === 'video' ? 'via-ink/70 via-35% to-transparent' : 'via-ink/60 to-ink/10',
      ]}
    ></div>
    <Grain />
  </div>

  <Container class="relative">
    <h1 class="text-display-xl max-w-5xl">
      <Highlighted text={hero.title} />
    </h1>
    <div class="mt-10 flex flex-wrap gap-4">
      <Button href={hero.primary.href} arrow>
        {hero.primary.label}
      </Button>
      <Button href={hero.secondary.href} variant="secondary">
        {hero.secondary.label}
      </Button>
    </div>
  </Container>

  {media.type === 'video' && (
    <button
      type="button"
      data-hero-toggle
      data-label-pause={site.labels.pauseVideo}
      data-label-play={site.labels.playVideo}
      aria-label={site.labels.pauseVideo}
      class="absolute right-4 bottom-4 grid size-10 place-items-center rounded-full border border-bone/40 text-bone hover:border-bone motion-reduce:hidden sm:right-8 sm:bottom-8"
    >
      <svg
        data-icon-pause
        viewBox="0 0 16 16"
        class="size-4"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M4 3h3v10H4zM9 3h3v10H9z" />
      </svg>
      <svg
        data-icon-play
        viewBox="0 0 16 16"
        class="hidden size-4"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M4 2.5v11L13 8z" />
      </svg>
    </button>
  )}
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]')
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]')

  if (video) {
    // Reduced-motion visitors only ever see the poster still.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.pause()
      video.removeAttribute('autoplay')
      video.preload = 'none'
    }

    toggle?.addEventListener('click', () => {
      const paused = !video.paused
      if (paused) video.pause()
      else void video.play()
      toggle.setAttribute(
        'aria-label',
        (paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) ?? '',
      )
      toggle.querySelector('[data-icon-pause]')?.classList.toggle('hidden', paused)
      toggle.querySelector('[data-icon-play]')?.classList.toggle('hidden', !paused)
    })
  }
</script>
