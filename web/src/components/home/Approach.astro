---
import PageSection from '@/components/ui/PageSection.astro'
import SectionHeader from '@/components/ui/SectionHeader.astro'
import { home } from '@/data/home'

const { approach } = home
---

<PageSection id="approach" tone="raised">
  <SectionHeader eyebrow={approach.eyebrow} title={approach.title} />
  <ol class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    {approach.steps.map((step, index) => (
      <li class="border-t border-signal pt-6">
        <p class="font-display text-sm text-signal">{String(index + 1).padStart(2, '0')}</p>
        <h3 class="mt-3 text-xl">{step.title}</h3>
        <p class="mt-2 text-ash">{step.body}</p>
      </li>
    ))}
  </ol>
</PageSection>
