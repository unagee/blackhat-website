---
import LoopVideo from '@/components/ui/LoopVideo.astro'
import { home } from '@/data/home'

const { showcase } = home
---

<!-- The whole portfolio in motion, full width. -->
<figure class="relative bg-ink">
  <LoopVideo
    src={showcase.video}
    poster={showcase.image}
    class="h-[60svh] min-h-80 w-full sm:h-[80svh]"
  />
</figure>
