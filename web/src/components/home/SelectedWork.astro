---
import Button from '@/components/ui/Button.astro'
import PageSection from '@/components/ui/PageSection.astro'
import SectionHeader from '@/components/ui/SectionHeader.astro'
import WorkCard from '@/components/ui/WorkCard.astro'
import { home } from '@/data/home'
import { projectBySlug, projectHref } from '@/data/projects'
import { serviceNames } from '@/data/services'

const { work } = home
const projects = work.projects.map(projectBySlug)
---

<PageSection id="work" tone="raised" labelledby="work-title">
  <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
    <SectionHeader id="work-title" eyebrow={work.eyebrow} title={work.title} />
    <div class="-mt-4 mb-12 sm:mt-0">
      <Button href={work.allLink.href} variant="secondary" arrow>
        {work.allLink.label}
      </Button>
    </div>
  </div>
  <ul class="grid gap-12 md:grid-cols-3 md:gap-6 lg:gap-8">
    {projects.map((project) => (
      <li>
        <WorkCard
          client={project.client}
          label={serviceNames(project.services)}
          summary={project.summary}
          href={projectHref(project.slug)}
          image={project.image}
        />
      </li>
    ))}
  </ul>
</PageSection>
