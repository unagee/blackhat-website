---
import ArrowIcon from '@/components/ui/ArrowIcon.astro'
import Button from '@/components/ui/Button.astro'
import LoopVideo from '@/components/ui/LoopVideo.astro'
import PageSection from '@/components/ui/PageSection.astro'
import { expertiseGrid, expertiseOffsets } from '@/components/ui/expertiseLayout'
import { home } from '@/data/home'
import { projectBySlug, projectHref } from '@/data/projects'
import { serviceNames } from '@/data/services'

const { work } = home
const projects = work.projects.map((item) => ({ ...projectBySlug(item.slug), ...item }))
// Shapes per column, matching each clip: wide, square, portrait.
const shapes = ['aspect-[16/10]', 'aspect-square', 'aspect-4/5']
---

<!-- Same uneven columns as "Our Expertise", each card a short looping clip of the project. -->
<PageSection id="work" tone="raised" labelledby="work-title">
  <div class="flex flex-col justify-between gap-8 sm:flex-row sm:items-end">
    <h2 id="work-title" class="text-display-md max-w-3xl">
      {work.title}
    </h2>
    <div class="shrink-0">
      <Button href={work.allLink.href} variant="secondary" arrow>
        {work.allLink.label}
      </Button>
    </div>
  </div>

  <ol class:list={[expertiseGrid, 'mt-12 sm:mt-16']}>
    {projects.map((project, index) => (
      <li class:list={['group relative', expertiseOffsets[index]]}>
        <LoopVideo
          src={project.video}
          poster={project.image}
          class:list={['rounded-lg bg-ink', shapes[index]]}
        />
        <p class="mt-5 text-xs text-ash">{serviceNames(project.services)}</p>
        <h3 class="mt-3 text-xl">
          <a
            href={projectHref(project.slug)}
            class="after:absolute after:inset-0 group-hover:text-signal"
          >
            {project.client}
            <span
              aria-hidden="true"
              class="ml-2 inline-grid size-7 place-items-center rounded-full bg-bone align-[-0.25em] text-ink transition-colors group-hover:bg-signal"
            >
              <ArrowIcon class="size-3" />
            </span>
          </a>
        </h3>
        <p class="mt-3 max-w-sm text-sm text-ash">{project.summary}</p>
      </li>
    ))}
  </ol>
</PageSection>
