---
import Button from '@/components/ui/Button.astro'
import Highlighted from '@/components/ui/Highlighted.astro'
import PageSection from '@/components/ui/PageSection.astro'
import { home } from '@/data/home'

const { industries } = home
---

<PageSection id="industries" tone="light" labelledby="industries-title">
  <p class="eyebrow text-graphite">{industries.eyebrow}</p>
  <h2 id="industries-title" class="text-display-lg mt-6 max-w-5xl">
    <Highlighted text={industries.statement} />
  </h2>
  <div class="mt-10">
    <Button href={industries.link.href} variant="dark" arrow>
      {industries.link.label}
    </Button>
  </div>
</PageSection>
