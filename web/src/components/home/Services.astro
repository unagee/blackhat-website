---
import ArrowIcon from '@/components/ui/ArrowIcon.astro'
import PageSection from '@/components/ui/PageSection.astro'
import SectionHeader from '@/components/ui/SectionHeader.astro'
import { home } from '@/data/home'
import { Image } from 'astro:assets'

const { services } = home
// Image shape and width per column, in order: wide, square, small landscape.
const shapes = ['aspect-[16/10]', 'aspect-square', 'aspect-4/3']
const sizes = [
  '(min-width: 768px) 46vw, 100vw',
  '(min-width: 768px) 31vw, 100vw',
  '(min-width: 768px) 22vw, 100vw',
]
---

<!-- Three columns of different widths, each image with its own shape: brand widest, strategy
     smallest, so the row reads as a composition rather than a grid. Stacks on phones. -->
<PageSection id="services" labelledby="services-title">
  <SectionHeader id="services-title" eyebrow={services.eyebrow} title={services.title} />
  <ol class="grid items-start gap-12 md:grid-cols-[1.7fr_1.15fr_0.8fr] md:gap-8 lg:gap-12">
    {services.items.map((item, index) => (
      <li class="group relative flex flex-col">
        <div class="relative overflow-hidden rounded-lg bg-ink-raised">
          <Image
            src={item.image.src}
            alt={item.image.alt}
            widths={[480, 720, 960, 1280]}
            sizes={sizes[index]}
            class:list={[
              'w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none',
              shapes[index],
            ]}
          />
        </div>
        <p class="mt-5 text-sm text-ash" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </p>
        <h3 class="mt-2 text-xl lg:text-2xl">
          <a href={item.href} class="after:absolute after:inset-0 group-hover:text-signal">
            {item.label}
            <!-- Inline so the arrow follows the last word when the title wraps. -->
            <span
              aria-hidden="true"
              class="ml-2 inline-grid size-7 place-items-center rounded-full bg-bone align-[-0.25em] text-ink transition-colors group-hover:bg-signal"
            >
              <ArrowIcon class="size-3" />
            </span>
          </a>
        </h3>
        <p class="mt-3 max-w-md text-sm text-ash lg:text-base">{item.body}</p>
      </li>
    ))}
  </ol>
</PageSection>
