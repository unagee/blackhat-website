---
import ArrowIcon from '@/components/ui/ArrowIcon.astro'
import PageSection from '@/components/ui/PageSection.astro'
import SectionHeader from '@/components/ui/SectionHeader.astro'
import { home } from '@/data/home'
import { Image } from 'astro:assets'

const { services } = home
---

<PageSection id="services" labelledby="services-title">
  <SectionHeader id="services-title" eyebrow={services.eyebrow} title={services.title} />
  <ol class="grid gap-12 md:grid-cols-3 md:gap-6 lg:gap-8">
    {services.items.map((item, index) => (
      <li class="group relative flex flex-col">
        <div class="relative overflow-hidden rounded-lg bg-ink-raised">
          <Image
            src={item.image.src}
            alt={item.image.alt}
            widths={[480, 720, 960]}
            sizes="(min-width: 768px) 33vw, 100vw"
            class="aspect-4/3 w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none"
          />
        </div>
        <div class="mt-6 flex items-center justify-between" aria-hidden="true">
          <p class="text-sm text-ash">{String(index + 1).padStart(2, '0')}</p>
          <span class="grid size-8 place-items-center rounded-full bg-bone text-ink transition-colors group-hover:bg-signal">
            <ArrowIcon class="size-3.5" />
          </span>
        </div>
        <h3 class="mt-3 text-2xl">
          <a href={item.href} class="after:absolute after:inset-0 group-hover:text-signal">
            {item.label}
          </a>
        </h3>
        <p class="mt-3 text-ash">{item.body}</p>
      </li>
    ))}
  </ol>
</PageSection>
