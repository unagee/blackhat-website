---
import { expertiseGrid, expertiseShapes, expertiseSizes } from '@/components/ui/expertiseLayout'
import PageSection from '@/components/ui/PageSection.astro'
import SectionHeader from '@/components/ui/SectionHeader.astro'
import type { Service } from '@/data/services'
import { Image } from 'astro:assets'

type Props = {
  eyebrow: string
  offerings: Service['offerings']
}

// Same uneven columns as the homepage "Our Expertise".
const { eyebrow, offerings } = Astro.props
---

<PageSection id="services" tone="raised" labelledby="offerings-title">
  <SectionHeader id="offerings-title" eyebrow={eyebrow} title={offerings.title} />
  <ol class={expertiseGrid}>
    {offerings.items.map((item, index) => (
      <li>
        <div class="overflow-hidden rounded-lg bg-ink">
          <Image
            src={item.image.src}
            alt={item.image.alt}
            widths={[480, 720, 960, 1280]}
            sizes={expertiseSizes[index]}
            class:list={['w-full object-cover', expertiseShapes[index]]}
          />
        </div>
        <p class="mt-5 text-sm text-ash" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </p>
        <h3 class="mt-2 text-xl lg:text-2xl">{item.title}</h3>
        <p class="mt-3 max-w-md text-sm text-ash lg:text-base">{item.body}</p>
      </li>
    ))}
  </ol>
</PageSection>
