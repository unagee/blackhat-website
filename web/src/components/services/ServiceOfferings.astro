---
import PageSection from '@/components/ui/PageSection.astro'
import SectionHeader from '@/components/ui/SectionHeader.astro'
import type { Service } from '@/data/services'
import { Image } from 'astro:assets'

type Props = {
  eyebrow: string
  offerings: Service['offerings']
}

const { eyebrow, offerings } = Astro.props
---

<PageSection id="services" tone="raised" labelledby="offerings-title">
  <SectionHeader id="offerings-title" eyebrow={eyebrow} title={offerings.title} />
  <ul class="grid gap-12 md:grid-cols-3 md:gap-6 lg:gap-8">
    {offerings.items.map((item) => (
      <li>
        <div class="overflow-hidden rounded-lg bg-ink">
          <Image
            src={item.image.src}
            alt={item.image.alt}
            widths={[480, 720, 960]}
            sizes="(min-width: 768px) 33vw, 100vw"
            class="aspect-4/3 w-full object-cover"
          />
        </div>
        <h3 class="mt-6 text-2xl">{item.title}</h3>
        <p class="mt-3 text-ash">{item.body}</p>
      </li>
    ))}
  </ul>
</PageSection>
