---
import PageSection from '@/components/ui/PageSection.astro'
import SectionHeader from '@/components/ui/SectionHeader.astro'
import type { Service } from '@/data/services'
import { site } from '@/data/site'
import MotionScene, { type SceneId } from './MotionScene.astro'

type Props = {
  eyebrow: string
  process: Service['process']
}

const { eyebrow, process } = Astro.props
---

<PageSection id="process" labelledby="process-title">
  <div data-motion-root>
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <SectionHeader id="process-title" eyebrow={eyebrow} title={process.title} />
      <button
        type="button"
        data-motion-toggle
        data-label-pause={site.labels.pauseMotion}
        data-label-play={site.labels.playMotion}
        class="mb-12 shrink-0 self-start rounded-full border border-hairline px-4 py-1.5 text-sm whitespace-nowrap text-ash hover:border-bone hover:text-bone motion-reduce:hidden sm:self-auto"
      >
        {site.labels.pauseMotion}
      </button>
    </div>
    <ol class="grid gap-10 md:grid-cols-3 md:gap-6 lg:gap-8">
      {process.steps.map((step, index) => (
        <li>
          <MotionScene scene={`${process.motion}-${index + 1}` as SceneId} />
          <p class="mt-6 text-sm text-ash">{String(index + 1).padStart(2, '0')}</p>
          <h3 class="mt-2 text-xl">{step.title}</h3>
          <p class="mt-3 text-ash">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</PageSection>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-motion-toggle]').forEach((toggle) => {
    const root = toggle.closest<HTMLElement>('[data-motion-root]')
    toggle.addEventListener('click', () => {
      const paused = root?.toggleAttribute('data-motion-paused') ?? false
      toggle.textContent = (paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) ?? ''
    })
  })
</script>
