---
import PageSection from '@/components/ui/PageSection.astro'
import SectionHeader from '@/components/ui/SectionHeader.astro'
import type { Service } from '@/data/services'
import { Image } from 'astro:assets'

type Props = {
  eyebrow: string
  process: Service['process']
}

const { eyebrow, process } = Astro.props
---

<PageSection id="process" tone="light" labelledby="process-title">
  <SectionHeader id="process-title" eyebrow={eyebrow} title={process.title} tone="light" />
  <Image
    src={process.diagram.src}
    alt={process.diagram.alt}
    widths={[640, 960, 1400]}
    sizes="(min-width: 1152px) 1152px, 100vw"
    class="w-full"
  />
  <ol class="mt-12 grid gap-10 border-t border-ink/15 pt-10 md:grid-cols-3">
    {process.steps.map((step, index) => (
      <li>
        <p class="text-sm text-graphite">{String(index + 1).padStart(2, '0')}</p>
        <h3 class="mt-2 text-xl">{step.title}</h3>
        <p class="mt-3 text-graphite">{step.body}</p>
      </li>
    ))}
  </ol>
</PageSection>
