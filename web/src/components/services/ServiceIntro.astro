---
import PageSection from '@/components/ui/PageSection.astro'
import type { Service } from '@/data/services'

type Props = {
  intro: Service['intro']
}

const { intro } = Astro.props
---

<PageSection labelledby="intro-title" graphic="right">
  <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
    <h2 id="intro-title" class="text-display-md">
      {intro.title}
    </h2>
    <div class="text-lead space-y-6 text-ash">
      {intro.body.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </div>
</PageSection>
