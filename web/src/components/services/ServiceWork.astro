---
import Button from '@/components/ui/Button.astro'
import PageSection from '@/components/ui/PageSection.astro'
import SectionHeader from '@/components/ui/SectionHeader.astro'
import WorkCard from '@/components/ui/WorkCard.astro'
import { home } from '@/data/home'
import { projectHref, type Project } from '@/data/projects'
import { serviceNames } from '@/data/services'
import type { Link, Tone } from '@/types'

type Props = {
  eyebrow: string
  title: string
  projects: Project[]
  allLink: Link
  // Section ground: light grey on service pages, white where it follows a grey section.
  tone?: Tone
}

const { eyebrow, title, projects, allLink, tone = 'grey' } = Astro.props
// Projects featured on the homepage use the same image here, so they look the same across the site.
const homeImage = (slug: string) => home.work.projects.find((item) => item.slug === slug)?.still
// Images keep their own shape (no cropping). Up to three projects sit in one staggered row, sized
// to the count; more flow into staggered columns, like the Work page.
const count = projects.length
const row = count <= 3
const rowGrid = {
  1: 'md:grid-cols-[minmax(0,0.7fr)]',
  2: 'md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]',
  3: 'md:grid-cols-[minmax(0,1.45fr)_minmax(0,1.25fr)_minmax(0,1fr)]',
}[Math.min(Math.max(count, 1), 3) as 1 | 2 | 3]
const rowOffsets = ['', 'md:mt-28', 'md:mt-12']
---

<PageSection id="work" tone={tone} labelledby="work-title">
  <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
    <SectionHeader id="work-title" eyebrow={eyebrow} title={title} />
    <div class="-mt-4 mb-12 sm:mt-0">
      <Button href={allLink.href} variant="secondary" arrow>
        {allLink.label}
      </Button>
    </div>
  </div>
  <ul
    class:list={[
      row
        ? ['grid items-start gap-12 md:gap-8 lg:gap-12', rowGrid]
        : 'gap-8 sm:columns-2 lg:columns-3 lg:gap-12',
    ]}
  >
    {projects.map((project, index) => (
      <li class:list={[row ? rowOffsets[index] : 'mb-12 break-inside-avoid']}>
        <WorkCard
          client={project.client}
          label={serviceNames(project.services)}
          summary={project.summary}
          href={projectHref(project.slug)}
          image={homeImage(project.slug) ?? project.cardImage ?? project.image}
          video={project.cardVideo}
          natural
          sizes={
            row
              ? '(min-width: 768px) 40vw, 100vw'
              : '(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw'
          }
        />
      </li>
    ))}
  </ul>
</PageSection>
