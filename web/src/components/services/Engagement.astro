---
import Container from '@/components/ui/Container.astro'
import { engagement } from '@/data/services'

// Fine linear icons for Plan (a route to a pin), Design (layered frames) and Execute (a loop).
const icons: Record<string, string> = {
  plan: 'M13 40a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM16 37c8 0 6-9 13-11s6-3 6-3M35 6a6 6 0 0 0-6 6c0 4.5 6 10.5 6 10.5s6-6 6-10.5a6 6 0 0 0-6-6ZM35 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z',
  design: 'M8 12h22v16H8zM14 19h22v16H14zM20 26h22v16H20z',
  execute: 'M38 18A14 14 0 0 0 12 22M10 30a14 14 0 0 0 26 4M38 10v8h-8M10 38v-8h8',
}
---

<section id="engage" aria-labelledby="engage-title" class="bg-ink py-20 sm:py-28">
  <Container>
    <div class="on-light rounded-3xl bg-linear-to-br from-signal via-bone to-bone p-6 text-ink sm:p-10 lg:p-14">
      <div class="grid gap-6 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="eyebrow text-graphite">{engagement.eyebrow}</p>
          <h2 id="engage-title" class="text-display-lg mt-4">
            {engagement.title}
          </h2>
        </div>
        <p class="text-lead self-end text-graphite">{engagement.lead}</p>
      </div>
      <ol class="mt-12 grid gap-4 md:grid-cols-3 md:gap-x-6 md:gap-y-0">
        {engagement.items.map((item) => (
          <li class="flex flex-col rounded-2xl bg-ink p-6 text-bone sm:p-8 md:row-span-6 md:grid md:grid-rows-subgrid md:gap-0">
            <svg
              viewBox="0 0 48 48"
              class="size-14 text-signal"
              fill="none"
              stroke="currentColor"
              stroke-width="1"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={icons[item.id]} />
            </svg>
            <h3 class="mt-6 text-3xl">{item.name}</h3>
            <p class="mt-4 text-bone/85">{item.body}</p>

            <div class="mt-6 border-t border-bone/15 pt-6">
              <h4 class="text-sm text-ash">{engagement.deliverablesLabel}</h4>
              <ul class="mt-4 space-y-3 text-sm">
                {item.deliverables.map((deliverable) => (
                  <li class="flex gap-3">
                    <svg viewBox="0 0 20 20" class="size-5 shrink-0 text-signal" aria-hidden="true">
                      <circle cx="10" cy="10" r="9" fill="currentColor" fill-opacity="0.18" />
                      <path
                        d="M6 10.5l2.5 2.5L14 7.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                      />
                    </svg>
                    <span>{deliverable}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-6 border-t border-bone/15 pt-6">
              <h4 class="text-sm text-ash">{engagement.timeframeLabel}</h4>
              <p class="mt-3 flex items-center gap-3 text-sm">
                <svg
                  viewBox="0 0 20 20"
                  class="size-5 shrink-0 text-signal"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  aria-hidden="true"
                >
                  <circle cx="10" cy="10" r="8" />
                  <path d="M10 5.5V10l3 2" />
                </svg>
                {item.timeframe}
              </p>
            </div>

            <a
              href="#enquiry"
              data-engagement={item.id}
              class="mt-8 inline-flex justify-center rounded-full bg-signal px-6 py-3 font-medium text-on-signal transition-colors hover:bg-bone"
            >
              {item.cta}
            </a>
          </li>
        ))}
      </ol>
    </div>
  </Container>
</section>
