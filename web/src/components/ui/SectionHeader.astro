---
import type { Tone } from '@/types'
import Highlighted from './Highlighted.astro'

type Props = {
  eyebrow?: string
  title: string
  as?: 'h1' | 'h2'
  id?: string
  tone?: Tone
}

const { eyebrow, title, as: Heading = 'h2', id, tone = 'ink' } = Astro.props
const onLight = tone === 'light' || tone === 'signal'
---

<header class="mb-12 max-w-3xl">
  {eyebrow && (
    <p class:list={['eyebrow mb-4', onLight ? 'text-graphite' : 'text-signal']}>{eyebrow}</p>
  )}
  <Heading id={id} class:list={[Heading === 'h1' ? 'text-display-xl' : 'text-display-md']}>
    <Highlighted text={title} />
  </Heading>
</header>
