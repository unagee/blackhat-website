---
type Props = {
  eyebrow?: string
  title: string
  as?: 'h1' | 'h2'
}

const { eyebrow, title, as: Heading = 'h2' } = Astro.props
---

<header class="mb-12 max-w-3xl">
  {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
  <Heading class:list={[Heading === 'h1' ? 'text-display-xl' : 'text-display-md']}>{title}</Heading>
</header>
