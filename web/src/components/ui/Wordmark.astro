---
import wordmarkLight from '@/assets/logos/blackhat-wordmark-light.png'
import wordmarkDark from '@/assets/logos/blackhat-wordmark.png'
import { Image } from 'astro:assets'

type Props = {
  class?: string
  eager?: boolean
  // light: the white wordmark for dark grounds (default); dark: the black one for light grounds.
  variant?: 'light' | 'dark'
}

// The Blackhat wordmark as supplied (light or dark, on transparent): never crop or recolour it.
const { class: className, eager = false, variant = 'light' } = Astro.props
const wordmark = variant === 'dark' ? wordmarkDark : wordmarkLight
---

<Image
  src={wordmark}
  alt=""
  widths={[240, 480, 720]}
  sizes="240px"
  loading={eager ? 'eager' : 'lazy'}
  class:list={['block w-auto', className]}
/>
