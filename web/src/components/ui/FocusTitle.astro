---
import Highlighted from './Highlighted.astro'

type Props = {
  text: string
}

// Page headline with a focus-pull effect: a frosted lens over the start of the line blurs it,
// fading out so the end stays sharp. The text itself appears only once.
const { text } = Astro.props
---

<span class="focus-title">
  <Highlighted text={text} />
  <span class="focus-title-lens" aria-hidden="true"></span>
</span>
