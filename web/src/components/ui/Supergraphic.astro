---
import type { Pattern, Tone } from '@/types'

type Props = {
  side?: 'left' | 'right'
  pattern?: Pattern
  // The section ground, so cut-outs can be filled with it and lines get the right contrast.
  tone?: Tone
}

// Decorative line patterns built from the Blackhat star (the counter of the B logogram)
// and the diagonal of the wordmark:
// - cells: rounded cells on a grid leaning like the wordmark; where four corners meet, the gap forms the star.
// - slash: one line at the logo's slant, edge to edge, with a solid star riding on it.
// - split: the star cut into four symmetrical pieces, drawn apart along the grid lines.
const { side = 'right', pattern = 'cells', tone = 'ink' } = Astro.props
const id = `sg-${Math.random().toString(36).slice(2, 8)}`
const onLight = tone === 'light' || tone === 'signal'
const ground = {
  ink: 'fill-ink',
  raised: 'fill-ink-raised',
  light: 'fill-bone',
  signal: 'fill-signal',
}[tone]

// Layout is drawn for the right side; the left side mirrors positions but keeps the slant.
const X = (x: number) => (side === 'left' ? 1440 - x : x)
// The wordmark leans about 13 degrees.
const lean = Math.tan((13 * Math.PI) / 180)
const slant = (cx: number, cy: number) =>
  `translate(${cx} ${cy}) skewX(-13) translate(${-cx} ${-cy})`

// The four-point star with concave sides.
const star = (cx: number, cy: number, r: number) => {
  const k = 0.13 * r
  const m = 0.3 * r
  return [
    `M${cx} ${cy - r}`,
    `C${cx + k} ${cy - m} ${cx + m} ${cy - k} ${cx + r} ${cy}`,
    `C${cx + m} ${cy + k} ${cx + k} ${cy + m} ${cx} ${cy + r}`,
    `C${cx - k} ${cy + m} ${cx - m} ${cy + k} ${cx - r} ${cy}`,
    `C${cx - m} ${cy - k} ${cx - k} ${cy - m} ${cx} ${cy - r}Z`,
  ].join(' ')
}

// One quarter of the star: centre, one tip, the concave side, the next tip.
const quarter = (cx: number, cy: number, r: number, q: 0 | 1 | 2 | 3) => {
  const k = 0.13 * r
  const m = 0.3 * r
  const [sx, sy] = [
    [1, -1],
    [1, 1],
    [-1, 1],
    [-1, -1],
  ][q]
  const vertical = q % 2 === 0
  const a = vertical ? [cx, cy + sy * r] : [cx + sx * r, cy]
  const b = vertical ? [cx + sx * r, cy] : [cx, cy + sy * r]
  const c1 = vertical ? [cx + sx * k, cy + sy * m] : [cx + sx * m, cy + sy * k]
  const c2 = vertical ? [cx + sx * m, cy + sy * k] : [cx + sx * k, cy + sy * m]
  return `M${cx} ${cy} L${a[0]} ${a[1]} C${c1[0]} ${c1[1]} ${c2[0]} ${c2[1]} ${b[0]} ${b[1]}Z`
}

// A rectangle with its own radius per corner: [top-left, top-right, bottom-right, bottom-left].
const cell = (x: number, y: number, w: number, h: number, r: number[]) => {
  const [tl, tr, br, bl] = r
  return [
    `M${x + tl} ${y}`,
    `H${x + w - tr}`,
    tr ? `A${tr} ${tr} 0 0 1 ${x + w} ${y + tr}` : '',
    `V${y + h - br}`,
    br ? `A${br} ${br} 0 0 1 ${x + w - br} ${y + h}` : '',
    `H${x + bl}`,
    bl ? `A${bl} ${bl} 0 0 1 ${x} ${y + h - bl}` : '',
    `V${y + tl}`,
    tl ? `A${tl} ${tl} 0 0 1 ${x + tl} ${y}` : '',
    'Z',
  ].join(' ')
}

// Cells: column and row edges, with a 2px gap that reads as a hairline.
const cols = [860, 1080, 1360, 1640]
const rows = [-80, 300, 560, 900]
const gap = 2
const R = 56
// Which corners are rounded, per cell, so stars form at only some crossings.
const rounding: Record<string, number[]> = {
  '0-0': [0, 0, R, 0],
  '1-0': [0, 0, 0, R],
  '0-1': [0, R, 0, 0],
  '1-1': [R, 0, R, 0],
  '2-1': [0, 0, 0, R],
  '1-2': [0, R, 0, 0],
  '2-2': [R, 0, 0, 0],
  '2-0': [0, 0, 0, 0],
  '0-2': [0, 0, 0, 0],
}
const cells = Object.entries(rounding).map(([key, r]) => {
  const [c, row] = key.split('-').map(Number)
  const x0 = cols[c]
  const y0 = rows[row]
  const w = cols[c + 1] - x0
  const h = rows[row + 1] - y0
  // Mirror the rounding with the layout on the left side.
  const radii = side === 'left' ? [r[1], r[0], r[3], r[2]] : r
  return cell(Math.min(X(x0), X(x0 + w)) + gap / 2, y0 + gap / 2, w - gap, h - gap, radii)
})

// Slash: the line passes through (sx, sy).
const sx = 1330
const sy = 470
const lineX = (y: number) => X(sx) + (sy - y) * lean
---

<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
  <svg
    viewBox="0 0 1440 800"
    preserveAspectRatio="xMidYMid slice"
    class:list={['size-full', onLight ? 'text-ink' : 'text-bone']}
    fill="none"
    stroke="currentColor"
  >
    <defs>
      <radialGradient id={`${id}-glow`}>
        <stop offset="0" stop-color="currentColor" stop-opacity={onLight ? 0.35 : 0.5}></stop>
        <stop offset="0.5" stop-color="currentColor" stop-opacity={onLight ? 0.12 : 0.14}></stop>
        <stop offset="1" stop-color="currentColor" stop-opacity="0"></stop>
      </radialGradient>
      <clipPath id={`${id}-cells`}>
        <rect x={side === 'left' ? 0 : cols[0]} y="0" width={1440 - cols[0]} height="800" />
      </clipPath>
      <linearGradient id={`${id}-fade`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="currentColor" stop-opacity="0"></stop>
        <stop offset="0.3" stop-color="currentColor" stop-opacity="1"></stop>
        <stop offset="0.8" stop-color="currentColor" stop-opacity="1"></stop>
        <stop offset="1" stop-color="currentColor" stop-opacity="0"></stop>
      </linearGradient>
    </defs>

    {pattern === 'cells' && (
      <g transform={slant(X(1220), 430)}>
        {/* Light behind the cells shows only through the gaps and the star cut-outs. */}
        <circle
          cx={X(1220)}
          cy="430"
          r="520"
          fill={`url(#${id}-glow)`}
          stroke="none"
          clip-path={`url(#${id}-cells)`}
        />
        <g class={ground} stroke="none">
          {cells.map((d) => (
            <path d={d} />
          ))}
        </g>
        <g stroke-opacity={onLight ? 0.16 : 0.12} stroke-width="1">
          <path d={`M${X(cols[0])} 0 V800`} stroke={`url(#${id}-fade)`} />
          <path d={`M${X(cols[1])} 0 V800`} stroke={`url(#${id}-fade)`} />
          <path d={`M${X(cols[2])} 0 V800`} stroke={`url(#${id}-fade)`} />
        </g>
      </g>
    )}

    {pattern === 'slash' && (
      <g>
        {!onLight && (
          <circle
            cx={X(sx)}
            cy={sy}
            r="380"
            fill={`url(#${id}-glow)`}
            stroke="none"
            opacity="0.4"
          />
        )}
        {/* A faint parallel line, then the main line from edge to edge, with the star on it. */}
        <path
          d={`M${lineX(-20) + 230} -20 L${lineX(820) + 230} 820`}
          stroke-opacity={onLight ? 0.18 : 0.14}
          stroke-width="1"
        />
        <g class={onLight ? 'text-ink' : 'text-signal'} stroke="currentColor" stroke-width="3">
          <path d={`M${lineX(-20)} -20 L${lineX(820)} 820`} stroke-opacity={onLight ? 1 : 0.85} />
          <path
            d={star(lineX(sy), sy, 38)}
            transform={slant(lineX(sy), sy)}
            fill="currentColor"
            stroke="none"
          />
        </g>
        <path
          d={star(lineX(sy), sy, 120)}
          transform={slant(lineX(sy), sy)}
          stroke-opacity={onLight ? 0.18 : 0.16}
          stroke-width="1"
          stroke-dasharray="2 6"
        />
      </g>
    )}

    {pattern === 'split' && (
      <g>
        {/* Grid through the centre: the logo's slant and one level line. */}
        <g stroke-opacity={onLight ? 0.16 : 0.12} stroke-width="1">
          <path
            d={`M${X(1120) + 420 * lean} -20 L${X(1120) - 420 * lean} 820`}
            stroke={`url(#${id}-fade)`}
          />
          <path d={`M${X(700)} 400 H${X(1440)}`} />
        </g>
        <g transform={slant(X(1120), 400)}>
          {([0, 1, 2, 3] as const).map((q) => {
            const d = 26
            const [dx, dy] = [
              [d, -d],
              [d, d],
              [-d, d],
              [-d, -d],
            ][q]
            return (
              <path
                d={quarter(X(1120), 400, 290, q)}
                transform={`translate(${dx} ${dy})`}
                stroke-opacity={onLight ? 0.22 : 0.2}
                stroke-width="1.2"
                fill={q === (side === 'left' ? 3 : 0) ? 'currentColor' : 'none'}
                fill-opacity={onLight ? 0.06 : 0.04}
              />
            )
          })}
          <path
            d={star(X(1120), 400, 14)}
            fill="currentColor"
            stroke="none"
            opacity={onLight ? 0.6 : 0.8}
          />
        </g>
      </g>
    )}

    {pattern === 'star' && (
      <g>
        {!onLight && (
          <circle
            cx={X(1120)}
            cy="420"
            r="420"
            fill={`url(#${id}-glow)`}
            stroke="none"
            opacity="0.3"
          />
        )}
        <g stroke-opacity={onLight ? 0.14 : 0.12} stroke-width="1">
          <path d={`M${X(860)} 0 V800`} stroke={`url(#${id}-fade)`} />
          <path d={`M${X(1300)} 0 V800`} stroke={`url(#${id}-fade)`} />
          <path d={`M${X(700)} 180 H${X(1440)}`} />
          <path d={`M${X(760)} 660 H${X(1440)}`} />
        </g>
        <path
          d={star(X(1120), 420, 300)}
          transform={slant(X(1120), 420)}
          stroke-opacity={onLight ? 0.2 : 0.22}
          stroke-width="1.2"
        />
        <path
          d={star(X(860), 180, 14)}
          transform={slant(X(860), 180)}
          fill="currentColor"
          stroke="none"
          opacity={onLight ? 0.5 : 0.7}
        />
      </g>
    )}
  </svg>
</div>
