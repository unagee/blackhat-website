---
import type { Picture } from '@/types'
import { Image } from 'astro:assets'
import ArrowIcon from './ArrowIcon.astro'

type Props = {
  client: string
  label: string
  summary: string
  href: string
  image: Picture
}

const { client, label, summary, href, image } = Astro.props
---

<article class="group relative">
  <div class="overflow-hidden rounded-lg bg-ink">
    <Image
      src={image.src}
      alt={image.alt}
      widths={[480, 720, 960]}
      sizes="(min-width: 768px) 33vw, 100vw"
      class="aspect-4/5 w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none"
    />
  </div>
  <p class="mt-5 text-sm text-ash">{label}</p>
  <h3 class="mt-2 text-2xl">
    <a
      href={href}
      class="inline-flex items-center gap-3 after:absolute after:inset-0 group-hover:text-signal"
    >
      {client}
      <ArrowIcon class="transition-transform group-hover:translate-x-1 motion-reduce:transition-none" />
    </a>
  </h3>
  <p class="mt-2 text-ash">{summary}</p>
</article>
