---
import type { Link, Tone } from '@/types'
import Button from './Button.astro'
import Highlighted from './Highlighted.astro'
import PageSection from './PageSection.astro'

type Props = {
  title: string
  body: string
  link: Link
  tone?: Tone
  // Star supergraphic: only where the page has no other one nearby.
  graphic?: 'left' | 'right'
}

const { title, body, link, tone = 'ink', graphic } = Astro.props
const onLight = tone === 'light' || tone === 'signal'
---

<PageSection tone={tone} graphic={graphic}>
  <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-3xl">
      <h2 class="text-display-lg">
        <Highlighted text={title} />
      </h2>
      <p class:list={['text-lead mt-6 max-w-2xl', onLight ? 'text-graphite' : 'text-ash']}>
        {body}
      </p>
    </div>
    <Button
      href={link.href}
      variant={onLight ? 'dark' : 'primary'}
      arrow
      class="self-start lg:self-auto"
    >
      {link.label}
    </Button>
  </div>
</PageSection>
