---
import ArrowIcon from './ArrowIcon.astro'

type Props = {
  href: string
  variant?: 'primary' | 'secondary' | 'dark'
  arrow?: boolean
  class?: string
}

const { href, variant = 'primary', arrow = false, class: className } = Astro.props
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center justify-center gap-3 rounded-full py-3 pr-3 pl-6', // Layout
    'text-base font-medium transition-colors', // Type
    !arrow && 'pr-6',
    variant === 'primary' && 'bg-signal text-on-signal hover:bg-bone',
    variant === 'secondary' && 'border border-bone/40 text-bone hover:border-bone',
    variant === 'dark' && 'bg-ink text-bone hover:bg-graphite',
    className,
  ]}
>
  <slot />
  {arrow && (
    <span
      aria-hidden="true"
      class:list={[
        'grid size-7 place-items-center rounded-full transition-transform group-hover:translate-x-0.5',
        variant === 'primary' && 'bg-on-signal text-signal',
        variant === 'secondary' && 'bg-bone text-ink',
        variant === 'dark' && 'bg-signal text-on-signal',
      ]}
    >
      <ArrowIcon class="size-3.5" />
    </span>
  )}
</a>
