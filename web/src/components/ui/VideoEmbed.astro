---
import type { Picture } from '@/types'
import { Image } from 'astro:assets'

type Props = {
  youtubeId: string
  title: string
  poster: Picture
  playLabel: string
}

// A YouTube video that loads only when the visitor presses play (privacy-friendly, no cookies before play).
// Without JavaScript the poster links to the video on YouTube.
const { youtubeId, title, poster, playLabel } = Astro.props
---

<div
  class="relative aspect-video overflow-hidden rounded-lg bg-ink-raised"
  data-video={youtubeId}
  data-title={title}
>
  <a
    href={`https://www.youtube.com/watch?v=${youtubeId}`}
    class="group absolute inset-0 grid place-items-center"
    data-video-play
  >
    <Image
      src={poster.src}
      alt=""
      widths={[640, 960, 1280, 1920]}
      sizes="(min-width: 1152px) 1152px, 100vw"
      class="absolute inset-0 size-full object-cover"
    />
    <span
      aria-hidden="true"
      class="absolute inset-0 bg-ink/40 transition-colors group-hover:bg-ink/25"
    ></span>
    <span class="relative flex items-center gap-3 rounded-full bg-signal py-3 pr-6 pl-3 font-medium text-on-signal">
      <span
        aria-hidden="true"
        class="grid size-9 place-items-center rounded-full bg-on-signal text-signal"
      >
        <svg viewBox="0 0 16 16" class="size-4" fill="currentColor">
          <path d="M5 3v10l8-5z"></path>
        </svg>
      </span>
      <span>
        {playLabel}
        <span class="sr-only">: {title}</span>
      </span>
    </span>
  </a>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((frame) => {
    frame.querySelector('[data-video-play]')?.addEventListener('click', (event) => {
      event.preventDefault()
      const iframe = document.createElement('iframe')
      iframe.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.video}?autoplay=1&rel=0`
      iframe.title = frame.dataset.title ?? ''
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen'
      iframe.allowFullscreen = true
      iframe.className = 'absolute inset-0 size-full'
      frame.replaceChildren(iframe)
      iframe.focus()
    })
  })
</script>
