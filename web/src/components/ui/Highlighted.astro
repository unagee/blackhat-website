---
type Props = {
  text: string
}

// Renders copy where words wrapped in *asterisks* get the serif italic highlight, and a line
// break (\n) starts a new line. Use the highlight sparingly: one per heading, on the most
// important headings only.
const { text } = Astro.props
const parts = text.split(/\*([^*]+)\*/)
---

{parts.map((part, index) =>
  index % 2 === 1 ? (
    <em class="highlight">{part}</em>
  ) : (
    part.split('\n').map((line, lineIndex) => (lineIndex > 0 ? [<br />, line] : line))
  ),
)}
