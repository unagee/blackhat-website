---
type Props = {
  text: string
}

// Renders copy where words wrapped in *asterisks* get the serif italic highlight.
// Use it sparingly: one highlight per heading, on the most important headings only.
const { text } = Astro.props
const parts = text.split(/\*([^*]+)\*/)
---

{parts.map((part, index) => (index % 2 === 1 ? <em class="highlight">{part}</em> : part))}
